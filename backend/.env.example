PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/Fito
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Used only by `npm run seed:admin` to create the first super admin.
SEED_SUPER_ADMIN_EMAIL=super@Fito.com
SEED_SUPER_ADMIN_PASSWORD=password

# Free Gmail SMTP for sending OTP emails (register / forgot-password).
# Requires a Google Account with 2-Step Verification turned on, then create
# an App Password at https://myaccount.google.com/apppasswords — use that
# 16-character code here, NOT your normal Gmail password.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Google OAuth Client ID (Web application) from console.cloud.google.com,
# used to verify the ID token from the frontend's "Sign in with Google".
# Must match app/.env.local's NEXT_PUBLIC_GOOGLE_CLIENT_ID exactly.
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Cloudinary account (free tier is fine) — all image/file uploads (products,
# blogs, consultation photos/reports) go straight here via
# src/middleware/upload.middleware.js. Get these from
# https://console.cloudinary.com/console (Dashboard page).
CLOUDINARY_CLOUD_NAME=xxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxx
